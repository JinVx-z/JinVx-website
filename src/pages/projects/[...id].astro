---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';
import AgentVisual from '../../components/AgentVisual.astro';
export async function getStaticPaths() {
  return (await getProjects()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="article-header">
    <a class="text-link" href="/projects/">
      ← 返回 Projects
    </a>
    <div class="article-meta">
      <span class="status-label">
        <span class="status-dot"></span>
        {entry.data.status}
      </span>
      {entry.data.demo && <span class="demo-badge">演示项目介绍</span>}
    </div>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <div class="flex gap-2 flex-wrap">
      {entry.data.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    <div class="project-external-links">
      {entry.data.repository && (
        <a href={entry.data.repository} class="button button-primary">
          GitHub 仓库 ↗
        </a>
      )}
      {entry.data.website && (
        <a href={entry.data.website} class="button button-secondary">
          访问网站 ↗
        </a>
      )}
    </div>
  </div>
  <div class="project-detail">
    {entry.data.visual === 'agent' && <AgentVisual />}
    <article class="prose">
      {entry.data.demo && (
        <aside class="callout">
          <strong>演示项目介绍</strong>
          <p>
            以下文字用于展示项目页面，并非对已实现功能或实际进度的声明。请按项目现状替换。
          </p>
        </aside>
      )}
      <Content />
    </article>
  </div>
</BaseLayout>
