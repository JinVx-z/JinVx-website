---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getWriting, getProjects, formatDate } from '../lib/content';

const [blog, notes, projects] = await Promise.all([
  getWriting('blog'),
  getWriting('notes'),
  getProjects(),
]);
const featured =
  projects.find((project) => project.data.featured) ?? projects[0];
---

<BaseLayout fullWidth>
  <div class="home-intro">
    <div class="container">
      <section class="profile-hero" aria-labelledby="profile-name">
        <img
          class="profile-avatar"
          src={site.avatar}
          alt={`${site.author} 的头像`}
          width="104"
          height="104"
          loading="eager"
          decoding="async"
        />
        <h1 id="profile-name">{site.author}</h1>
        <p class="profile-role">{site.role}</p>
        <div class="profile-links">
          <a href={site.github || '/about/#contact'}>
            <Icon name="github" size={20} /> GitHub
          </a>
          <a href="/about/">
            关于我 <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <div class="home-body">
        <section
          class="home-layout home-about"
          aria-labelledby="home-about-title"
        >
          <h2 id="home-about-title">About</h2>
          <div>
            <p>{site.intro}</p>
            {featured && (
              <p class="project-note">
                目前关注{' '}
                <a href={`/projects/${featured.id}/`}>{featured.data.title}</a>
                ：{featured.data.description}
                {featured.data.demo && <span class="demo-badge">演示介绍</span>}
              </p>
            )}
            {site.demoProfile && (
              <p class="home-demo-note">
                个人介绍及标有「演示」的内容为可替换示例。
                <a href="/about/#profile">了解更多 ↗</a>
              </p>
            )}
          </div>
        </section>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="home-body">
      <section class="home-layout" aria-labelledby="home-blog-title">
        <h2 id="home-blog-title">Blog</h2>
        <div>
          <div class="home-list">
            {blog.slice(0, 5).map((entry) => (
              <a class="home-entry" href={`/blog/${entry.id}/`}>
                <time
                  class="entry-meta"
                  datetime={entry.data.date.toISOString()}
                >
                  {formatDate(entry.data.date)}
                </time>
                <span class="entry-title">
                  {entry.data.title}
                  {entry.data.demo && <span class="demo-badge">演示</span>}
                </span>
                <span class="entry-arrow" aria-hidden="true">
                  ›
                </span>
              </a>
            ))}
            {blog.length === 0 && (
              <p class="home-empty">第一篇文章正在酝酿中。</p>
            )}
          </div>
          <p class="home-more">
            <a href="/blog/">
              全部文章 <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>

      <section class="home-layout" aria-labelledby="home-notes-title">
        <h2 id="home-notes-title">Notes</h2>
        <div>
          <div class="home-list">
            {notes.slice(0, 4).map((entry) => (
              <a class="home-entry" href={`/notes/${entry.id}/`}>
                <span class="entry-meta">{entry.data.kind}</span>
                <span class="entry-title">
                  {entry.data.title}
                  {entry.data.demo && <span class="demo-badge">演示</span>}
                </span>
                <span class="entry-arrow" aria-hidden="true">
                  ›
                </span>
              </a>
            ))}
            {notes.length === 0 && (
              <p class="home-empty">留一点空间，给下一个想法。</p>
            )}
          </div>
          <p class="home-more">
            <a href="/notes/">
              全部笔记 <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
