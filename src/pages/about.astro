---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="About"
  description={`认识 ${site.author}：开发、学习，以及这个网站背后的想法。`}
>
  <section class="page-heading">
    <p class="eyebrow">THE PERSON BEHIND THE CODE</p>
    <h1>
      About<span class="accent">.</span>
    </h1>
    <p>代码之外，也想留一点空间给自己。</p>
  </section>
  <div class="about-layout">
    <aside class="profile-panel">
      <div class="avatar-monogram" aria-hidden="true">
        J<span>.</span>
      </div>
      <h2>{site.author}</h2>
      <p class="mono">{site.role}</p>
      {site.location && <p>{site.location}</p>}
      <div class="profile-divider"></div>
      <p>{site.tagline}</p>
      {site.demoProfile && <span class="demo-badge">个人资料为演示占位</span>}
    </aside>
    <div class="about-copy">
      <section id="profile">
        <h2>你好，我是 {site.author}。</h2>
        <p>{site.intro}</p>
        {site.demoProfile && (
          <aside class="callout">
            <strong>这里留给真正的你</strong>
            <p>
              当前定位、自我介绍及下方文字为演示文案。请修改全局配置与本页面，填写自己的经历、兴趣和愿意公开的信息。
            </p>
          </aside>
        )}
      </section>
      <section>
        <h2>我在探索什么</h2>
        <div class="interest-row">
          <span class="mono accent">01 /</span>
          <div>
            <h3>Personal Agent</h3>
            <p>
              从工作与项目场景开始，思考上下文、状态、人工确认和执行如何连接起来。
            </p>
          </div>
        </div>
        <div class="interest-row">
          <span class="mono accent">02 /</span>
          <div>
            <h3>Web & tools</h3>
            <p>通过小而完整的项目学习开发，把日常遇到的问题做成顺手的工具。</p>
          </div>
        </div>
        <div class="interest-row">
          <span class="mono accent">03 /</span>
          <div>
            <h3>Learning in public</h3>
            <p>
              写下做过的取舍与仍未想明白的问题，让记录成为下一次实践的起点。
            </p>
          </div>
        </div>
      </section>
      <section>
        <h2>关于这个小站</h2>
        <p>
          JinVx 是一个个人主页，也是一块数字花园。Projects 放作品，Blog
          放整理后的长文，Notes 放还在生长的想法。
        </p>
        <p>
          用 Astro 构建，用 Markdown
          写作。希望这里轻一点、安静一点，让内容自己说话。
        </p>
      </section>
      <section id="contact">
        <h2>保持联系</h2>
        <p>如果你也对 Agent、开发或学习感兴趣，欢迎交流。</p>
        <div class="contact-grid">
          <div class="contact-item">
            <Icon name="github" size={22} />
            <div>
              <h3>GitHub</h3>
              {site.github ? (
                <a class="text-link" href={site.github}>
                  {new URL(site.github).pathname.slice(1)} ↗
                </a>
              ) : (
                <p>待配置 · 请填写你的 GitHub 地址</p>
              )}
            </div>
          </div>
          <div class="contact-item">
            <Icon name="mail" size={22} />
            <div>
              <h3>Email</h3>
              {site.email ? (
                <a class="text-link" href={`mailto:${site.email}`}>
                  {site.email} ↗
                </a>
              ) : (
                <p>待配置 · 请填写公开联系邮箱</p>
              )}
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
