---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div
  class:list={['agent-visual', { compact }]}
  aria-label="Personal Agent 当前能力示意：授权来源、确认状态、回答依据与读取评测"
  role="img"
>
  <div class="visual-top">
    <span class="flex gap-1.5">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span>personal-agent / workspace</span>
    <span>↗</span>
  </div>
  <div class="agent-stage">
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <svg
      class="orbit-lines"
      viewBox="0 0 400 260"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M92 75 200 130 305 67M200 130 95 203M200 130 307 204"
        stroke="currentColor"
        stroke-dasharray="4 5"
      />
    </svg>
    <div class="agent-core">
      <span>
        J<span class="core-dot">.</span>
      </span>
      <small>AGENT</small>
    </div>
    <span class="orbit-node node-context">
      <span>⌘</span> Sources
    </span>
    <span class="orbit-node node-plan">
      <span>≡</span> State
    </span>
    <span class="orbit-node node-review">
      <span>✓</span> Evidence
    </span>
    <span class="orbit-node node-build">
      <span>↗</span> Eval
    </span>
    <span class="visual-coordinate">[ READ ONLY · USER CONFIRMED STATE ]</span>
  </div>
  <div class="visual-bottom">
    <span>
      <span class="status-dot"></span> 从资料到可追溯的状态
    </span>
    <span>in development · 2026.10</span>
  </div>
</div>
