---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, hasRealDomain } from '../config/site';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  noindex?: boolean;
  fullWidth?: boolean;
}
const {
  title,
  description = site.description,
  article = false,
  date,
  noindex = false,
  fullWidth = false,
} = Astro.props;
const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} — Build, learn, share.`;
const canonical = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#d9efff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#42586c"
      media="(prefers-color-scheme: dark)"
    />
    {(!hasRealDomain || noindex) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} Blog & Notes`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL('/og.png', site.url)} />
    <meta property="og:image:alt" content="JinVx — Build, learn, share." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', site.url)} />
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
      (() => {
        let saved;
        try {
          saved = localStorage.getItem('jinvx-theme');
        } catch {}
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
  </head>
  <body class:list={{ 'reading-page': article }}>
    <a class="skip-link" href="#main">
      跳转到内容
    </a>
    <Header />
    <main id="main" class:list={{ container: !fullWidth }} tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
