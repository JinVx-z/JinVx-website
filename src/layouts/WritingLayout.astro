---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';
import type { Writing } from '../lib/content';
import { formatDate, readingTime } from '../lib/content';
interface Props {
  entry: Writing;
  collection: 'blog' | 'notes';
  headings: MarkdownHeading[];
}
const { entry, collection, headings } = Astro.props;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  article
  date={entry.data.date}
>
  <div class="article-header">
    <a href={`/${collection}/`} class="text-link">
      ← 返回 {collection === 'blog' ? 'Blog' : 'Notes'}
    </a>
    <div class="article-meta">
      <time datetime={entry.data.date.toISOString()}>
        {formatDate(entry.data.date)}
      </time>
      <span>·</span>
      <span>{readingTime(entry.body)} 分钟阅读</span>
      {entry.data.demo && <span class="demo-badge">演示内容</span>}
    </div>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <div class="post-tags">
      {entry.data.tags.map((tag) => (
        <span>#{tag}</span>
      ))}
    </div>
    {entry.data.updated && (
      <p class="updated-date">更新于 {formatDate(entry.data.updated)}</p>
    )}
  </div>
  <div class="article-layout">
    <article class="prose">
      {entry.data.demo && (
        <aside class="callout demo-callout">
          <strong>这是一篇演示内容</strong>
          <p>用于展示排版与内容组织，请在发布个人网站前替换为自己的文字。</p>
        </aside>
      )}
      <slot />
      <div class="article-end">
        <span>✳</span>
        <p>谢谢你读到这里。</p>
        <a class="text-link" href={`/${collection}/`}>
          继续阅读其他{collection === 'blog' ? '文章' : '笔记'} →
        </a>
      </div>
    </article>
    {toc.length > 0 && (
      <aside class="toc">
        <nav aria-label="文章目录">
          <p class="mono">ON THIS PAGE</p>
          <ul>
            {toc.map((heading) => (
              <li class:list={{ 'toc-sub': heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
          <a href="#main" class="text-link back-top">
            回到顶部 ↑
          </a>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>
